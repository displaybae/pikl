# imagegen backend — required env var NAMES (values come from Railway in prod).
# Copy to .env for local dev. NEVER commit real values.

# HTTP
PORT=8401

# Image generation (RunPod Qwen-Image-Edit-2511)
RUNPOD_API_KEY=

# VLM (OpenRouter Gemini — describe / scan / verify)
OPENROUTER_API_KEY=

# Optional model overrides
# QWEN_MODEL=qwen-image-edit-2511
# VLM_MODEL=google/gemini-3.1-flash-lite
# VLM_VERIFY_MODEL=google/gemini-3.5-flash

# Postgres (shared railway DB — imagegen_* tables only). Unset -> local JSON + no analytics.
DATABASE_URL=

# Session token signing (HMAC). Unset -> per-boot random secret (tokens die on restart).
SESSION_SECRET=

# Nickname that becomes admin on login.
ADMIN_NICKNAME=

# Cloudflare R2 storage (S3 API). Unset -> local ./output + ./wardrobe fallback.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
